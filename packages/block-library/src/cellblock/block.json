{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "core/cellblock",
	"title": "Cellblock",
	"description": "Tabulate blocks.",
	"category": "widgets",
	"attributes": {
		"columns": {
			"type": "number",
			"default": 2
		}
	},
	"textdomain": "default",
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:index.js",
	"editorStyle": "file:editor.css"
}
